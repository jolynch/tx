#!/usr/bin/env bash
# Usage: scripts/fuzz [-race] PACKAGE TARGET DURATION DEADLINE [test flags...]
#
# Fuzzes TARGET in PACKAGE for DURATION. It builds the test binary first, so
# compile time does not count against the budget, then ends fuzzing with
# SIGINT rather than -fuzztime. Go reports a -fuzztime expiry that races its
# own shutdown as "context deadline exceeded", failing a run that found
# nothing; an interrupt ends fuzzing through a path without that race. A
# fuzzer still running a minute after the interrupt is killed.
# DEADLINE is the test binary's -test.timeout. A TARGET that matches no fuzz
# test fails instead of silently passing, as does one that spends DURATION
# replaying its cached corpus and never reaches new inputs: Go prints "now
# fuzzing" only once that replay ends. A failure prints how long the target
# ran and the contents of each failing input it wrote, so a CI log alone is
# enough to reproduce it.
set -euo pipefail

race=()
if [ "${1:-}" = "-race" ]; then
	race=(-race)
	shift
fi
if [ $# -lt 4 ]; then
	echo "usage: $0 [-race] PACKAGE TARGET DURATION DEADLINE [test flags...]" >&2
	exit 2
fi
pkg=$1 target=$2 duration=$3 deadline=$4
shift 4

importpath=$(go list "$pkg")
dir=$(go list -f '{{.Dir}}' "$pkg")
bin=$(mktemp -d)/fuzz.test
log=$(mktemp)
trap 'rm -rf "$(dirname "$bin")" "$log"' EXIT

# -fuzz at build time adds the coverage instrumentation fuzzing is guided by.
go test "${race[@]}" -fuzz="^${target}\$" -c -o "$bin" "$pkg"

flags=()
for f in "$@"; do
	flags+=("-test.${f#-}") # -parallel=1 -> -test.parallel=1
done

echo "fuzz $importpath $target for $duration"
cd "$dir"
corpus="testdata/fuzz/$target"
before=$(ls "$corpus" 2>/dev/null || true)
start=$SECONDS
# The script signals the fuzzer itself rather than through timeout(1):
# uutils timeout, the default from Ubuntu 26.04, sends SIGKILL at once when
# given --kill-after. SIGKILL follows a minute after SIGINT only if the
# fuzzer has not exited, since -test.timeout does not cover fuzzing.
watchdog() {
	local pid=$1 nap=
	trap 'kill "$nap" 2>/dev/null; exit 0' TERM
	sleep "$duration" &
	nap=$!
	wait "$nap"
	kill -INT "$pid" 2>/dev/null || exit 0
	sleep 60 &
	nap=$!
	wait "$nap"
	kill -KILL "$pid" 2>/dev/null || true
}

set +e
{
	# A background job starts with SIGINT ignored; the fuzzer's
	# signal.Notify reinstates it.
	"$bin" -test.run='^$' -test.fuzz="^${target}\$" -test.timeout="$deadline" \
		-test.fuzzcachedir="$(go env GOCACHE)/fuzz/$importpath" -test.paniconexit0 \
		"${flags[@]}" 2>&1 &
	pid=$!
	watchdog "$pid" >/dev/null 2>&1 &
	dog=$!
	wait "$pid"
	status=$?
	kill "$dog" 2>/dev/null
	wait "$dog"
	exit "$status"
} | tee "$log"
rc=${PIPESTATUS[0]}
set -e
if [ "$rc" -ne 0 ]; then
	echo "fuzz: $target in $importpath failed after $((SECONDS - start))s of $duration (exit $rc)" >&2
	for name in $(ls "$corpus" 2>/dev/null || true); do
		if grep -qxF "$name" <<<"$before"; then
			continue
		fi
		echo "fuzz: failing input $dir/$corpus/$name:" >&2
		cat "$corpus/$name" >&2
		echo "fuzz: to reproduce, save it there and run: go test ${race[*]} -run='^$target\$/^$name\$' $pkg" >&2
	done
fi
if [ "$rc" -eq 0 ] && ! grep -q 'now fuzzing' "$log"; then
	if grep -q '^fuzz: elapsed' "$log"; then
		echo "fuzz: $target in $importpath spent $duration replaying its corpus and never fuzzed;" \
			"run go clean -fuzzcache to empty $(go env GOCACHE)/fuzz/$importpath/$target, or allow more time" >&2
	else
		echo "fuzz: $target in $importpath ran no fuzzing; check the package and target name" >&2
	fi
	exit 1
fi
exit "$rc"
